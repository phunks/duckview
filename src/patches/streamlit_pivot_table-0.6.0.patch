@@ -0,0 +1,85 @@
+import { useLayoutEffect, useState, type RefObject } from "react";
+import type { HeaderMenuTarget } from "./TableRenderer";
+
+const VIEWPORT_MARGIN = 8;
+const MENU_MAX_HEIGHT = 440;
+
+export function computeHeaderMenuPlacement(
+  rect: Pick<DOMRect, "top" | "bottom" | "left">,
+  menuWidth: number,
+  menuHeight: number,
+  viewportWidth: number,
+  viewportHeight: number,
+) {
+  const width = Math.max(0, viewportWidth - 2 * VIEWPORT_MARGIN);
+  const height = Math.max(0, viewportHeight - 2 * VIEWPORT_MARGIN);
+  const left = Math.max(
+    VIEWPORT_MARGIN,
+    Math.min(rect.left, viewportWidth - VIEWPORT_MARGIN - Math.min(menuWidth, width)),
+  );
+  const below = Math.max(
+    0,
+    viewportHeight - VIEWPORT_MARGIN - Math.max(rect.bottom, VIEWPORT_MARGIN),
+  );
+  const above = Math.max(
+    0,
+    Math.min(rect.top, viewportHeight - VIEWPORT_MARGIN) - VIEWPORT_MARGIN,
+  );
+  const openAbove = below < Math.min(menuHeight, MENU_MAX_HEIGHT) && above > below;
+  const maxHeight = Math.min(MENU_MAX_HEIGHT, openAbove ? above : below, height);
+  const top = openAbove
+    ? Math.max(
+        VIEWPORT_MARGIN,
+        Math.min(rect.top, viewportHeight - VIEWPORT_MARGIN) -
+          Math.min(menuHeight, maxHeight),
+      )
+    : Math.max(VIEWPORT_MARGIN, Math.min(rect.bottom, viewportHeight - VIEWPORT_MARGIN));
+  return { top, left, maxHeight };
+}
+
+/** Measure the rendered menu (including any dynamic sections) before painting it. */
+export function useHeaderMenuPlacement(
+  target: HeaderMenuTarget | null,
+  overlayRef: RefObject<HTMLDivElement | null>,
+) {
+  const [placement, setPlacement] = useState<{
+    target: HeaderMenuTarget;
+    position: ReturnType<typeof computeHeaderMenuPlacement>;
+  }>();
+
+  useLayoutEffect(() => {
+    if (!target || !overlayRef.current) return;
+    const overlay = overlayRef.current;
+    const menu = overlay.firstElementChild as HTMLElement | null;
+    const update = () => {
+      if (!menu) return;
+      const position = computeHeaderMenuPlacement(
+        target.rect,
+        menu.offsetWidth,
+        // scrollHeight also accounts for content that was capped by the viewport.
+        Math.min(menu.scrollHeight || menu.offsetHeight, MENU_MAX_HEIGHT),
+        window.innerWidth,
+        window.innerHeight,
+      );
+      setPlacement((previous) =>
+        previous?.target === target &&
+        previous.position.top === position.top &&
+        previous.position.left === position.left &&
+        previous.position.maxHeight === position.maxHeight
+          ? previous
+          : { target, position },
+      );
+    };
+    update();
+    window.addEventListener("resize", update);
+    const observer =
+      typeof ResizeObserver !== "undefined" ? new ResizeObserver(update) : null;
+    if (menu) observer?.observe(menu);
+    return () => {
+      window.removeEventListener("resize", update);
+      observer?.disconnect();
+    };
+  }, [target, overlayRef]);
+
+  return placement?.target === target ? placement.position : undefined;
+}
