+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import TableRenderer from "./TableRenderer";
+import VirtualizedTableRenderer from "./VirtualizedTableRenderer";
+import { PivotData } from "../engine/PivotData";
+import { makeConfig } from "../test-utils";
+import { computeHeaderMenuPlacement } from "./useHeaderMenuPlacement";
+
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+});
+
+describe("computeHeaderMenuPlacement", () => {
+  const viewportWidth = 800;
+  const viewportHeight = 600;
+
+  it("opens below the header when there is room", () => {
+    expect(
+      computeHeaderMenuPlacement(
+        { top: 80, bottom: 110, left: 100 },
+        240,
+        300,
+        viewportWidth,
+        viewportHeight,
+      ),
+    ).toEqual({ top: 110, left: 100, maxHeight: 440 });
+  });
+
+  it("moves left and above near the viewport edges", () => {
+    expect(
+      computeHeaderMenuPlacement(
+        { top: 540, bottom: 570, left: 750 },
+        240,
+        300,
+        viewportWidth,
+        viewportHeight,
+      ),
+    ).toEqual({ top: 240, left: 552, maxHeight: 440 });
+  });
+
+  it("caps the menu to available space and lets its contents scroll", () => {
+    expect(
+      computeHeaderMenuPlacement(
+        { top: 100, bottom: 130, left: 80 },
+        240,
+        440,
+        800,
+        240,
+      ),
+    ).toEqual({ top: 130, left: 80, maxHeight: 102 });
+  });
+
+  it("fits in a viewport narrower than the default menu width", () => {
+    expect(
+      computeHeaderMenuPlacement(
+        { top: 40, bottom: 60, left: 70 },
+        210,
+        200,
+        180,
+        280,
+      ),
+    ).toEqual({ top: 60, left: 8, maxHeight: 212 });
+  });
+});
+
+describe.each(["regular", "virtualized"])("%s header menu overlay", (renderer) => {
+  it("positions the measured menu inside the viewport", () => {
+    vi.stubGlobal("ResizeObserver", class {
+      observe() {}
+      disconnect() {}
+    });
+    vi.spyOn(window, "innerWidth", "get").mockReturnValue(800);
+    vi.spyOn(window, "innerHeight", "get").mockReturnValue(600);
+    const config = makeConfig();
+    const pivotData = new PivotData(
+      [{ region: "US", year: "2024", revenue: 100 }],
+      config,
+    );
+    const props = { pivotData, config, onSortChange: vi.fn() };
+    if (renderer === "regular") {
+      render(<TableRenderer {...props} />);
+    } else {
+      render(<VirtualizedTableRenderer {...props} containerHeight={300} />);
+    }
+    const trigger = screen.getAllByTestId("header-menu-trigger-year")[0];
+    vi.spyOn(trigger, "getBoundingClientRect").mockReturnValue({
+      top: 540,
+      bottom: 570,
+      left: 750,
+    } as DOMRect);
+    vi.spyOn(HTMLElement.prototype, "offsetWidth", "get").mockReturnValue(240);
+    vi.spyOn(HTMLElement.prototype, "scrollHeight", "get").mockReturnValue(300);
+    fireEvent.click(trigger);
+    const overlay = screen.getByTestId("header-menu-year").parentElement as HTMLElement;
+    expect(overlay.style.top).toBe("240px");
+    expect(overlay.style.left).toBe("552px");
+    expect(overlay.style.maxHeight).toBe("440px");
+    expect(overlay.style.visibility).toBe("visible");
+  });
+});
